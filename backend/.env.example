# =============================================================================
# ENVIRONMENT VARIABLES EXAMPLE FILE - BACKEND
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL / APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendor_security_db
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password_here

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# Generate a strong secret key: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# -----------------------------------------------------------------------------
# EMAIL SERVICE (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# AI CONFIGURATION - MULTIPLE PROVIDER SUPPORT
# -----------------------------------------------------------------------------
# Choose your AI provider by setting AI_PROVIDER
# Options: qwen, gemini, openai, qwen_direct, gemini_direct, ollama, lmstudio
# Default: qwen (free tier via OpenRouter)
# Note: If AI_API_KEY is not set, the system will use rule-based analysis as fallback

# --- Option 1: Qwen via OpenRouter (Recommended for International Users) ---
# Free tier available with daily limits
# Get API key from: https://openrouter.ai/
AI_PROVIDER=qwen
# AI_API_KEY=your-openrouter-api-key
# AI_MODEL=qwen/qwen-2.5-72b-instruct

# --- Option 2: Gemini via OpenRouter ---
# Free tier available with daily limits
# AI_PROVIDER=gemini
# AI_API_KEY=your-openrouter-api-key
# AI_MODEL=google/gemini-flash-1.5

# --- Option 3: Direct Google AI Studio (Gemini) ---
# Free tier available (60 requests/minute)
# Get API key from: https://aistudio.google.com/apikey
# AI_PROVIDER=gemini_direct
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=your-google-ai-studio-api-key
# AI_MODEL=gemini-1.5-flash

# --- Option 4: Direct Qwen API (Alibaba Cloud DashScope) ---
# Only if you have access to Alibaba Cloud international
# AI_PROVIDER=qwen_direct
# AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# AI_API_KEY=your-dashscope-api-key
# AI_MODEL=qwen-plus

# --- Option 5: OpenAI ---
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=your-openai-api-key
# AI_MODEL=gpt-4-turbo

# --- Option 6: Local Ollama (Completely Free, Self-hosted) ---
# Install from: https://ollama.ai/
# Run: ollama run llama3.1
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=not-needed-for-local
# AI_MODEL=llama3.1

# --- Option 7: Local LM Studio (Completely Free, Self-hosted) ---
# Download from: https://lmstudio.ai/
# AI_PROVIDER=lmstudio
# AI_BASE_URL=http://localhost:1234/v1
# AI_API_KEY=not-needed-for-local
# AI_MODEL=local-model

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Use * for all origins (development only) or comma-separated list for production
# Example: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# TEST CREDENTIALS (for automated testing)
# -----------------------------------------------------------------------------
TEST_EMAIL=admin@example.com
TEST_PASSWORD=testpassword123
